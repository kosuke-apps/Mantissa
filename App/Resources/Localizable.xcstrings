{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Calculator": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電卓"
          }
        }
      }
    },
    "Type a math problem…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数式を入力してください…"
          }
        }
      }
    },
    "Please enter a complete math problem so we can solve it!": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算できるよう、式を最後まで入力してください。"
          }
        }
      }
    },
    "Dividing by zero has no answer.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 で割ることはできません。"
          }
        }
      }
    },
    "This has no real answer.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この式には実数の答えがありません。"
          }
        }
      }
    },
    "This is too large to work out.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きすぎて計算できません。"
          }
        }
      }
    },
    "Equations and inequalities are not supported yet.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方程式と不等式にはまだ対応していません。"
          }
        }
      }
    },
    "This has no real value.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実数の値はありません。"
          }
        }
      }
    },
    "Letters": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字"
